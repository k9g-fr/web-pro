<!doctype html>
<html lang="en">
<%- include("head") %>

<body>
    <%- include("header") %>

    <main class="content-wrapper">
        <h2 class="table-title">Employee List</h2>
        
        <div class="table-container">
            <table class="panda-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Title</th>
                        <th>Phone</th>
                        <th>Email</th>
                    </tr>
                </thead>
                <tbody>
                    <% data.forEach((item) => { %>
                        <tr>
                            <td><%= item.EmployeeId %></td>
                            <td><%= item.FirstName %></td>
                            <td><%= item.LastName %></td>
                            <td><%= item.Title %></td>
                            <td><%= item.Phone %></td>
                            <td><%= item.Email %></td>
                            <td><a href="/delete/<%= item.EmployeeId %>">Delete</a></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </main>

    <%- include("footer") %>
</body>
</html>